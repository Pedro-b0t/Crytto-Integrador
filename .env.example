# Frontend - URL do backend (deixe vazio para usar proxy nginx /api)
VITE_API_URL=

# Backend
PORT=3001
HOST=0.0.0.0
BACKEND_HOST_PORT=3001
FRONTEND_HOST_PORT=80
DB_HOST_PORT=5432

# Banco de dados Postgres gerenciado (Neon/Supabase) ou local via docker-compose
# Ex.: postgres://user:pass@ep-abc.us-east-2.aws.neon.tech/crytto?sslmode=require
DATABASE_URL=postgres://crytto:crytto@localhost:5432/crytto
# Desative SSL apenas quando conectar em Postgres local (docker-compose já faz isso).
PGSSL=false

# CORS: restringe a origem do frontend. Deixe vazio para liberar geral.
FRONTEND_URL=
